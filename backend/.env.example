# Copie ce fichier en ".env" et remplis les valeurs avant de lancer le serveur.

# Chaine de connexion MongoDB (MongoDB Atlas ou autre)
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/yaka-marche

# Cle secrete pour signer les tokens JWT (mets une longue chaine aleatoire)
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# Cle API Brevo (transactionnel email) - https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Adresse d'expedition des emails (doit etre validee dans Brevo)
BREVO_SENDER_EMAIL=contact@worldifyai.com
BREVO_SENDER_NAME=Yaka Marche

# Port du serveur
PORT=5000

# Origine publique du site. Avec le service Render unique, l'API et Next.js
# partagent cette origine ; conserver CORS_ORIGIN pour les clients externes.
CORS_ORIGIN=http://localhost:3000
# URL publique du site (sans slash final), utilisee dans les emails de
# reinitialisation du mot de passe.
APP_URL=https://yaka-marche.xyz

# --- Administration ---
# Email du compte autorise a utiliser l'espace admin Next.js (/admin)
ADMIN_EMAIL=admin@yaka-marche.xyz

# --- Mise en avant (boost) ---
# Prix de la mise en avant en FCFA
BOOST_PRICE_FCFA=500

# Mobile Money (MTN) ou envoyer le paiement
MOMO_NUMBER=06 000 00 00
MOMO_NAME=Nom Prenom

# Paiement crypto alternatif
CRYPTO_NETWORK=USDT (TRC20)
CRYPTO_ADDRESS=adresse-de-portefeuille-a-remplacer
CRYPTO_AMOUNT=0.80 USDT

# Nombre de filleuls (inscriptions via lien de parrainage) pour debloquer
# une mise en avant gratuite
REFERRAL_THRESHOLD=5